setBatchMode(false);

function processND2Image(filePath, micronSizeMin, micronSizeMax, maxPercentage, minPercentage, Zo1, chosen, dir) {

    maxMean = 0;
    brightestStack = 0;

    run("Duplicate...", "duplicate channels="+Zo1);


    for (sliceIndex = 1; sliceIndex <= nSlices; sliceIndex++) {
        setSlice(sliceIndex);
        getStatistics(area, mean, min, max);
        if (mean > maxMean) {
            maxMean = mean;
            brightestStack = sliceIndex;
        }
    }close();

    
    if (nSlices == brightestStack) {
        exit("Error: no basal");
    } else {
	print(filePath + " Brightest stack is " + brightestStack);
    }

    nChannels = getDimensions(width, height, channels, slices, frames);
    // Basal  
    basalRange = "" + (brightestStack + 1) + "-" + (nSlices/nChannels);  
    //print(basalRange);
    if (chosen == "basal") {
     	run("Duplicate...", "duplicate channels=2 slices=" + basalRange);
    	processImage("Basal", "basal", filePath, micronSizeMin, micronSizeMax, maxPercentage, minPercentage, dir);

        close();
    }
    // Apical
    apicalRange = "1-" + (brightestStack - 1);
    //print(apicalRange); 
    if (chosen == "apical") {
    	run("Duplicate...", "duplicate channels=2 slices=" + apicalRange);
    	processImage("Apical", "apical", filePath, micronSizeMin, micronSizeMax, maxPercentage, minPercentage, dir);
        close();
    }
    //Total
    if (chosen == "total") {
        run("Duplicate...", "duplicate channels=2");
        processImage("Total", "total", filePath, micronSizeMin, micronSizeMax, maxPercentage, minPercentage, dir);
        close();

    }

}

function processImage(imageTitle, prefix, filePath, micronSizeMin, micronSizeMax, maxPercentage, minPercentage, dir) {
    getDimensions(width, height, channels, slices, frames);
    if (slices > 1) {
    	run("Z Project...", "projection=[Max Intensity]");
    }
    //run("Enhance Contrast", "saturated=0.35");
    getStatistics(area, mean, min, max);

    MaxPixelValue = max;
    maximumvalue = (maxPercentage / 100.0) * MaxPixelValue;
    minimumvalue = (minPercentage / 100.0) * MaxPixelValue;

    setMinAndMax(minimumvalue, maximumvalue);
    run("8-bit");
    setAutoThreshold("Otsu");
    //setThreshold(1, 255);
    run("Convert to Mask");
    run("Convert to Mask"); //depending on if images are inverted, just delete a convert to mask command if it is. or run a third for funzies

    finalfolder = dir + "/1finalfolder";
    filename = prefix + "_" + File.getName(filePath);
    folderPath = finalfolder + "/" + filename;
    saveAs("tiff", folderPath);

    run("Analyze Particles...", "size=" + micronSizeMin + "-" + micronSizeMax + " clear summarize overlay");

}
